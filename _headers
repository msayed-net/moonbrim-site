# Cloudflare Pages response headers. See:
# https://developers.cloudflare.com/pages/configuration/headers/
#
# /stories/* pages are pruned in place whenever a job's YouTube post is no
# longer exactly "live" (see pipeline/site_gen.py's PRIVACY GATE). Pages'
# default edge cache (observed: public, s-maxage=604800 — 7 days) purges
# reliably for paths that CHANGE between deploys, but a path that is REMOVED
# entirely (pruned) can keep serving a stale 200 from edge cache until that
# TTL expires, since there is no new asset at that URL for the deploy-time
# purge to key off. A short cache lifetime here bounds how long a pruned
# story page can still leak from cache after this file first ships — down
# from up to 7 days to a few minutes — without needing an explicit
# zone-level cache purge (this API token is not granted that permission; see
# the deploy report for the two entries this shipped with still stale).
/stories/*
  Cache-Control: public, max-age=300, s-maxage=300

# /podcast/* binaries (episodes/*.m4a, cover.jpg) moved to R2
# (media.moonbrim.com) 2026-07-31 — pipeline/podcast_gen.py no longer
# writes them into this site clone at all, so a REMOVED file here has
# nothing to purge against on the next deploy either, same edge-cache gap
# as /stories/* above (up to 7 days stale by Pages' default). Added this
# rule when removing the last two committed episodes/cover.jpg so any
# stale moonbrim.com/podcast/* URL a subscriber's client cached before the
# migration expires quickly instead of lingering — same 5-minute bound,
# same rationale as /stories/* above.
/podcast/*
  Cache-Control: public, max-age=300, s-maxage=300
